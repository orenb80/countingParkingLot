# Backend settings — copy to backend/.env

# Database (SQLite default, swap for PostgreSQL in production)
DATABASE_URL=sqlite:///./parking.db

# Amadeus 8 integration (leave blank to disable)
AMADEUS_HOST=
AMADEUS_PORT=8080
AMADEUS_API_KEY=

# Hikvision defaults
HIKVISION_DEFAULT_PORT=80
HIKVISION_EVENT_POLL_INTERVAL=5
